# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Required for the contact and hire forms and analytics. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site (used for SEO, sitemap and Open Graph image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: instant email alerts for new messages / hire requests (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional: fallback "Book a call" link (the Admin → Settings value takes priority)
NEXT_PUBLIC_BOOKING_URL=
